<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin:__HOME__/.local/bin</string>
		<key>UAM_RUNTIME_MANIFEST</key>
		<string>__RUNTIME_MANIFEST__</string>
	</dict>
	<key>Label</key>
	<string>com.openjay.uam.tunnel</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__UAM_HOME__/current/service/uam-tunnel-wrapper.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/tunnel-stderr.log</string>
	<key>StandardOutPath</key>
	<string>__LOG_DIR__/tunnel-stdout.log</string>
	<key>ThrottleInterval</key>
	<integer>15</integer>
</dict>
</plist>
