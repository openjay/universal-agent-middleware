{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:universal-agent-middleware:schema:executor-result-v1",
  "title": "UAM Executor Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_version",
    "result_id",
    "contract_id",
    "workspace_id",
    "base_revision",
    "final_revision",
    "changed_paths",
    "verification",
    "unresolved_risks",
    "executor",
    "completed_at"
  ],
  "properties": {
    "result_version": {
      "const": "uam-executor-result-v1"
    },
    "result_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "base_revision": {
      "type": "string"
    },
    "final_revision": {
      "type": "string"
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executor": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    }
  }
}
