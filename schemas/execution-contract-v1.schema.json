{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:universal-agent-middleware:schema:execution-contract-v1",
  "title": "UAM Execution Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "profile",
    "contract_id",
    "workspace_id",
    "base_revision",
    "objective",
    "non_goals",
    "authoritative_paths",
    "allowed_change_paths",
    "constraints",
    "implementation_decision",
    "expected_changes",
    "acceptance_criteria",
    "verification_commands",
    "risk_notes",
    "rollback",
    "open_questions",
    "created_at",
    "created_by"
  ],
  "properties": {
    "contract_version": {
      "const": "uam-execution-contract-v1"
    },
    "profile": {
      "enum": [
        "repository-change-v1"
      ]
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authoritative_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "allowed_change_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_decision": {
      "type": "string",
      "minLength": 1
    },
    "expected_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    }
  }
}
