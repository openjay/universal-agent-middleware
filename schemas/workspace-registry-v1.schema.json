{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:universal-agent-middleware:schema:workspace-registry-v1",
  "title": "UAM Workspace Registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "workspaces"
  ],
  "properties": {
    "registry_version": {
      "const": "uam-workspace-registry-v1"
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace_id",
          "root",
          "kind",
          "capabilities"
        ],
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "git-repository",
              "filesystem-directory"
            ]
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "filesystem.read",
                "git.observe"
              ]
            }
          },
          "max_file_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 10485760
          },
          "max_search_files": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "project_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "lifecycle": {
            "type": "string"
          },
          "repository_identity": {
            "type": "string"
          },
          "discovery": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "description": "A directory is not a repository: it can only read files and has no Git identity.",
            "if": {
              "properties": {
                "kind": {
                  "const": "filesystem-directory"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "capabilities": {
                  "items": {
                    "const": "filesystem.read"
                  }
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "repository_identity"
                    ]
                  },
                  {
                    "required": [
                      "discovery"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
